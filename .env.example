# =============================================================================
# deAPI MCP Server - Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# -----------------------------------------------------------------------------
# MCP Server Configuration (for remote hosting)
# -----------------------------------------------------------------------------
# Host to bind the server to (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
MCP_HOST=0.0.0.0

# Port for the MCP server
MCP_PORT=8000

# Public base URL for OAuth endpoints (optional fallback)
# The server auto-detects HTTPS from X-Forwarded-Proto headers from ingress/proxy.
# Only set this if automatic detection fails in your environment.
# Example: PUBLIC_BASE_URL=https://mcp.example.com
# PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# OAuth / JWT Configuration
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens used in OAuth flow
# IMPORTANT: Set this in production to keep tokens valid across server restarts
# If not set, a random key is generated each time the server starts (dev/testing only)
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# DEAPI_JWT_SECRET_KEY=your-secret-key-here

# -----------------------------------------------------------------------------
# deAPI Configuration
# -----------------------------------------------------------------------------
# Base URL for the deAPI
DEAPI_API_BASE_URL=https://api.deapi.ai

# API version: only v2 is supported
DEAPI_API_VERSION=v2

# -----------------------------------------------------------------------------
# HTTP Client Configuration
# -----------------------------------------------------------------------------
# Request timeout in seconds
DEAPI_HTTP_TIMEOUT=30.0

# Maximum number of retry attempts. Reads are retried on 429, 5xx and network
# errors; a job submission only when it provably was not processed (429, or the
# connection never opened), so a job is never submitted twice.
DEAPI_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Polling Configuration
# -----------------------------------------------------------------------------
# You can override the default polling settings for each job type.
# Format: DEAPI_POLLING_{TYPE}__{SETTING}

# Audio transcription polling
# DEAPI_POLLING_AUDIO__INITIAL_DELAY=1.0
# DEAPI_POLLING_AUDIO__MAX_DELAY=5.0
# DEAPI_POLLING_AUDIO__TIMEOUT=300.0
# DEAPI_POLLING_AUDIO__BACKOFF_FACTOR=1.5

# Image generation polling
# DEAPI_POLLING_IMAGE__INITIAL_DELAY=2.0
# DEAPI_POLLING_IMAGE__MAX_DELAY=8.0
# DEAPI_POLLING_IMAGE__TIMEOUT=300.0
# DEAPI_POLLING_IMAGE__BACKOFF_FACTOR=1.5

# Video generation polling
# DEAPI_POLLING_VIDEO__INITIAL_DELAY=5.0
# DEAPI_POLLING_VIDEO__MAX_DELAY=30.0
# DEAPI_POLLING_VIDEO__TIMEOUT=900.0
# DEAPI_POLLING_VIDEO__BACKOFF_FACTOR=1.5

# Seconds one tool call waits for its job. A job still running after that is
# returned with done=false and its job_id; check_job_status(job_id, wait_seconds)
# resumes the wait. Keep it below your MCP client's call timeout (often 60s).
# DEAPI_TOOL_MAX_WAIT=45.0

# -----------------------------------------------------------------------------
# Model Description Enrichment
# -----------------------------------------------------------------------------
# When enabled, tool descriptions are enriched with available model info
# (slugs, parameter limits, guidance requirements) so LLMs can choose
# correct models without calling get_available_models first.
# DEAPI_ENRICH_TOOL_DESCRIPTIONS=true

# Cache TTL for model info used in description enrichment (seconds)
# DEAPI_MODEL_CACHE_TTL=300.0

# -----------------------------------------------------------------------------
# Internal Completion Webhooks
# -----------------------------------------------------------------------------
# When enabled, every job this server submits carries its own receiver URL, and
# the API calls back the moment the job finishes. The waiting tool wakes at once
# instead of polling the status endpoint every few seconds; polling continues
# underneath at the fallback interval as a safety net, so a lost callback costs
# latency, never correctness.
#
# The receiver URL must be reachable FROM api.deapi.ai (public ingress, https).
# Half-configured settings refuse to start rather than silently fall back to
# slow polling. A caller who passes their own webhook_url to a tool overrides
# this for that job (the API accepts one webhook per job).
#
# Known limitation: job tracking is in-process. With more than one replica a
# callback can land on a pod that is not waiting; that job then completes on
# the fallback poll.
# DEAPI_WEBHOOKS_INTERNAL=false
# DEAPI_WEBHOOK_RECEIVER_URL=https://mcp.example.com/webhooks/deapi
# DEAPI_WEBHOOK_SECRET=change-me-to-at-least-32-random-characters
# DEAPI_WEBHOOK_FALLBACK_POLL_INTERVAL=45.0
# DEAPI_WEBHOOK_TIMESTAMP_TOLERANCE=300.0

# -----------------------------------------------------------------------------
# OAuth Authorization Code Store
# -----------------------------------------------------------------------------
# Authorization codes are single-use and live 10 minutes. With a Redis host set
# they are shared, so any replica can finish a login; without one they stay in
# process memory, which only works with a single replica. A Redis outage only
# breaks new logins; tool calls with an existing token keep working.
# DEAPI_REDIS_HOST=redis.example.com
# DEAPI_REDIS_PORT=6379
# DEAPI_REDIS_USERNAME=
# DEAPI_REDIS_PASSWORD=
# DEAPI_REDIS_DB=11
# Connection scheme: plain | tls (tls needs DEAPI_REDIS_CA_FILE)
# DEAPI_REDIS_SCHEME=plain
# DEAPI_REDIS_CA_FILE=
# DEAPI_REDIS_PREFIX=deapi_mcp_database_
# true = refuse to start without a Redis host
# DEAPI_REDIS_REQUIRED=false

# -----------------------------------------------------------------------------
# Process
# -----------------------------------------------------------------------------
# Seconds in-flight tool calls may finish after SIGTERM before they are
# cancelled. Keep it below your platform's termination grace period.
# MCP_GRACEFUL_SHUTDOWN_SECONDS=930

# Proxies whose X-Forwarded-* headers are trusted (uvicorn). Narrow it to your
# ingress when the server is reachable other than through it.
# FORWARDED_ALLOW_IPS=*

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - All DEAPI_* variables can be set to customize the server behavior
# - An empty value (DEAPI_REDIS_PORT=) counts as unset: the default applies
# - Keep comments on their own line. Some loaders (docker --env-file,
#   kubectl --from-env-file) keep text after a value, "# ..." included, as part
#   of that value
# - Use environment-specific .env files (.env.development, .env.production)
# - For local development the defaults are enough; set DEAPI_JWT_SECRET_KEY
#   before exposing the server beyond localhost
# - API tokens should NEVER be stored in .env - they are passed per-request
